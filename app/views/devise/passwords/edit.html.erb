<div class="flex items-center justify-center min-h-[60vh] animate-fade-in-up">
  <div class="w-full max-w-md">
    <div class="text-center mb-8">
      <span class="text-4xl animate-float inline-block mb-4">🔐</span>
      <h2 class="text-2xl font-bold">ตั้งรหัสผ่านใหม่</h2>
      <p class="text-white/40 text-sm mt-2">กรอกรหัสผ่านใหม่ของคุณ</p>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "glass-strong rounded-2xl p-8 space-y-5" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div>
        <%= f.label :password, "รหัสผ่านใหม่", class: "block text-sm mb-2 text-white/60" %>
        <% if @minimum_password_length %>
          <p class="text-xs text-white/30 mb-1">อย่างน้อย <%= @minimum_password_length %> ตัวอักษร</p>
        <% end %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "input-field", placeholder: "••••••••" %>
      </div>

      <div>
        <%= f.label :password_confirmation, "ยืนยันรหัสผ่านใหม่", class: "block text-sm mb-2 text-white/60" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input-field", placeholder: "••••••••" %>
      </div>

      <%= f.submit "เปลี่ยนรหัสผ่าน", class: "btn-primary w-full !py-3" %>
    <% end %>

    <div class="mt-6 text-center text-sm text-white/40">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
