<h2 class="text-2xl font-bold mb-6">เข้าสู่ระบบ</h2>

<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "bg-white border rounded-lg p-6 space-y-4 max-w-md" }) do |f| %>
  <div>
    <%= f.label :email, class: "block text-sm mb-1" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full rounded border px-3 py-2" %>
  </div>

  <div>
    <%= f.label :password, "รหัสผ่าน", class: "block text-sm mb-1" %>
    <%= f.password_field :password, autocomplete: "current-password", class: "w-full rounded border px-3 py-2" %>
  </div>

  <% if devise_mapping.rememberable? %>
    <label class="flex items-center gap-2 text-sm">
      <%= f.check_box :remember_me %>
      <%= f.label :remember_me, "จดจำฉัน" %>
    </label>
  <% end %>

  <%= f.submit "เข้าสู่ระบบ", class: "rounded-lg bg-slate-900 text-white px-6 py-2 cursor-pointer" %>
<% end %>

<div class="mt-4">
  <%= render "devise/shared/links" %>
</div>
