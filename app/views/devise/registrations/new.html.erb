<h2 class="text-2xl font-bold mb-6">สมัครสมาชิก</h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "bg-white border rounded-lg p-6 space-y-4 max-w-md" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div>
    <%= f.label :name, "ชื่อ-นามสกุล", class: "block text-sm mb-1" %>
    <%= f.text_field :name, autofocus: true, class: "w-full rounded border px-3 py-2" %>
  </div>

  <div>
    <%= f.label :email, class: "block text-sm mb-1" %>
    <%= f.email_field :email, autocomplete: "email", class: "w-full rounded border px-3 py-2" %>
  </div>

  <div>
    <%= f.label :password, class: "block text-sm mb-1" %>
    <% if @minimum_password_length %>
      <p class="text-xs text-slate-500 mb-1">อย่างน้อย <%= @minimum_password_length %> ตัวอักษร</p>
    <% end %>
    <%= f.password_field :password, autocomplete: "new-password", class: "w-full rounded border px-3 py-2" %>
  </div>

  <div>
    <%= f.label :password_confirmation, "ยืนยันรหัสผ่าน", class: "block text-sm mb-1" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full rounded border px-3 py-2" %>
  </div>

  <%= f.submit "สมัครสมาชิก", class: "rounded-lg bg-slate-900 text-white px-6 py-2 cursor-pointer" %>
<% end %>

<div class="mt-4">
  <%= render "devise/shared/links" %>
</div>
