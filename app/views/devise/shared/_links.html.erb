<%- if controller_name != 'sessions' %>
  <%= link_to "เข้าสู่ระบบ", new_session_path(resource_name), class: "text-violet-400 hover:text-violet-300 transition-colors" %>
<% end %>

<%- if devise_mapping.registerable? && controller_name != 'registrations' %>
  <span class="mx-2 text-white/20">·</span>
  <%= link_to "สมัครสมาชิก", new_registration_path(resource_name), class: "text-violet-400 hover:text-violet-300 transition-colors" %>
<% end %>

<%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
  <p class="mt-3">
    <%= link_to "ลืมรหัสผ่าน?", new_password_path(resource_name), class: "text-white/30 hover:text-white/50 transition-colors text-xs" %>
  </p>
<% end %>
