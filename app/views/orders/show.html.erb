<%= link_to "← คำสั่งซื้อทั้งหมด", orders_path, class: "text-sm text-slate-600 mb-4 inline-block" %>

<div class="bg-white border rounded-lg p-6 mb-6">
  <div class="flex flex-wrap justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold">ออเดอร์ #<%= @order.id %></h1>
      <p class="text-sm text-slate-500 mt-1"><%= l(@order.created_at, format: :long) %></p>
    </div>
    <span class="inline-block h-fit rounded-full px-3 py-1 text-sm <%= order_status_badge_class(@order.status) %>">
      <%= @order.status_label %>
    </span>
  </div>

  <% if @order.tracking_number.present? %>
    <div class="mt-6 rounded-lg bg-indigo-50 border border-indigo-200 p-4">
      <p class="font-semibold text-indigo-900">เลขพัสดุ</p>
      <p class="text-lg mt-1"><%= @order.tracking_number %></p>
      <% if @order.shipped_at %>
        <p class="text-sm text-indigo-700 mt-1">จัดส่งเมื่อ <%= l(@order.shipped_at, format: :long) %></p>
      <% end %>
    </div>
  <% end %>

  <div class="mt-6 grid md:grid-cols-2 gap-6">
    <div>
      <h2 class="font-semibold mb-2">ที่อยู่จัดส่ง</h2>
      <p><%= @order.recipient_name %></p>
      <p><%= @order.phone %></p>
      <p class="whitespace-pre-line text-slate-600"><%= @order.address %></p>
    </div>
    <div>
      <h2 class="font-semibold mb-2">รายการ</h2>
      <% @order.order_items.each do |item| %>
        <div class="flex justify-between text-sm py-1">
          <span><%= item.product_name %> × <%= item.quantity %></span>
          <span><%= format_baht(item.subtotal) %></span>
        </div>
      <% end %>
      <div class="flex justify-between font-bold mt-3 pt-3 border-t">
        <span>รวม</span>
        <span><%= format_baht(@order.total_amount) %></span>
      </div>
    </div>
  </div>
</div>

<% if @order.can_upload_slip? %>
  <div class="bg-white border rounded-lg p-6 mb-6">
    <h2 class="font-semibold mb-4">แนบสลิปโอนเงิน</h2>

    <div class="mb-6 text-sm text-slate-600">
      <p>ธนาคาร: <%= @shop_setting.bank_name %></p>
      <p>เลขบัญชี: <%= @shop_setting.account_number %> (<%= @shop_setting.account_name %>)</p>
      <% if @shop_setting.qr_code.attached? %>
        <div class="mt-3"><%= image_tag @shop_setting.qr_code, class: "max-w-xs rounded border" %></div>
      <% end %>
    </div>

    <%= form_with model: @order.payment, url: order_payment_path(@order), method: :patch, html: { multipart: true }, class: "space-y-4" do |f| %>
      <div>
        <p class="text-sm mb-2">วิธีชำระ</p>
        <label class="flex items-center gap-2 mb-2">
          <%= f.radio_button :method, "bank_transfer", checked: @order.payment.bank_transfer? %>
          โอนบัญชี
        </label>
        <label class="flex items-center gap-2">
          <%= f.radio_button :method, "qr", checked: @order.payment.qr? %>
          QR Code
        </label>
      </div>
      <div>
        <%= f.label :slip, "ไฟล์สลิป (JPG, PNG, PDF)", class: "block text-sm mb-1" %>
        <%= f.file_field :slip, required: true, accept: "image/jpeg,image/png,image/webp,application/pdf", class: "block" %>
      </div>
      <%= f.submit "ส่งสลิป", class: "rounded-lg bg-indigo-600 text-white px-6 py-2 cursor-pointer" %>
    <% end %>
  </div>
<% end %>

<% if @order.payment.slip.attached? %>
  <div class="bg-white border rounded-lg p-6">
    <h2 class="font-semibold mb-4">สลิปที่แนบ</h2>
    <p class="text-sm text-slate-600 mb-2">วิธีชำระ: <%= @order.payment.method_label %> — <%= @order.payment.status_label %></p>
    <% if @order.payment.slip.content_type.start_with?("image/") %>
      <%= image_tag @order.payment.slip, class: "max-w-md rounded border" %>
    <% else %>
      <%= link_to "ดาวน์โหลดสลิป", rails_blob_path(@order.payment.slip, disposition: "attachment"), class: "text-indigo-600" %>
    <% end %>
  </div>
<% end %>
