<h1 class="text-2xl font-bold mb-6">คำสั่งซื้อของฉัน</h1>

<div class="space-y-4">
  <% @orders.each do |order| %>
    <%= link_to order_path(order), class: "block bg-white border rounded-lg p-4 hover:shadow-sm" do %>
      <div class="flex flex-wrap justify-between gap-4">
        <div>
          <p class="font-semibold">ออเดอร์ #<%= order.id %></p>
          <p class="text-sm text-slate-500"><%= l(order.created_at, format: :long) %></p>
        </div>
        <div class="text-right">
          <span class="inline-block rounded-full px-3 py-1 text-sm <%= order_status_badge_class(order.status) %>">
            <%= order.status_label %>
          </span>
          <p class="font-medium mt-2"><%= format_baht(order.total_amount) %></p>
        </div>
      </div>
    <% end %>
  <% end %>
</div>

<% if @orders.empty? %>
  <p class="text-slate-500">ยังไม่มีคำสั่งซื้อ</p>
<% end %>
