<div class="animate-fade-in-up mb-8">
  <h1 class="text-3xl font-bold mb-1">คำสั่งซื้อของฉัน</h1>
  <p class="text-white/40">ติดตามสถานะและชำระเงินได้ที่นี่</p>
</div>

<% if @orders.any? %>
  <div class="space-y-4">
    <% @orders.each_with_index do |order, i| %>
      <% needs_action = order.pending_payment? || (order.payment_rejected? && order.can_upload_slip?) %>
      <%= link_to order_path(order, (needs_action ? { pay: 1 } : {})),
          class: "block glass rounded-2xl p-5 md:p-6 transition-all duration-300 hover:border-white/20 hover:bg-white/[0.07] animate-fade-in-up #{needs_action ? 'border-2 border-amber-400/40 ring-1 ring-amber-400/20' : 'border border-white/10'}",
          style: "animation-delay: #{0.05 * i}s" do %>
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-3 mb-2">
              <p class="text-lg font-bold text-white">ออเดอร์ #<%= order.id %></p>
              <span class="inline-block rounded-full px-3 py-1 text-xs font-medium border <%= order_status_pill_class(order.status) %>">
                <%= order.status_label %>
              </span>
            </div>
            <p class="text-sm text-white/40"><%= l(order.created_at, format: :long) %></p>

            <% if order.order_items.any? %>
              <ul class="mt-3 space-y-1">
                <% order.order_items.first(2).each do |item| %>
                  <li class="text-sm text-white/60 truncate">
                    <%= item.product_name %>
                    <span class="text-white/30">× <%= item.quantity %></span>
                  </li>
                <% end %>
                <% if order.order_items.size > 2 %>
                  <li class="text-xs text-white/30">+ อีก <%= order.order_items.size - 2 %> รายการ</li>
                <% end %>
              </ul>
            <% end %>
          </div>

          <div class="text-right shrink-0">
            <p class="text-xs text-white/40 mb-1">ยอดรวม</p>
            <p class="text-xl font-bold bg-gradient-to-r from-violet-400 to-amber-400 bg-clip-text text-transparent">
              <%= format_baht(order.total_amount) %>
            </p>
            <p class="text-sm mt-3 font-medium <%= needs_action ? 'text-amber-300' : 'text-violet-400' %>">
              <%= order_action_hint(order) %>
            </p>
          </div>
        </div>

        <% if order.pending_payment? && order.payment_deadline_at.present? && order.payment_deadline_at > Time.current %>
          <div class="mt-4 pt-4 border-t border-amber-500/20 flex flex-wrap items-center gap-2 text-sm text-amber-300/90">
            <span class="relative flex h-2 w-2 shrink-0">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-400"></span>
            </span>
            รอชำระเงิน — หมดเวลา <%= l(order.payment_deadline_at, format: :short) %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="glass rounded-2xl p-16 text-center animate-fade-in">
    <span class="text-5xl mb-4 block opacity-20">📦</span>
    <p class="text-white/40 mb-6">ยังไม่มีคำสั่งซื้อ</p>
    <%= link_to "เลือกการ์ด", products_path, class: "btn-primary" %>
  </div>
<% end %>
