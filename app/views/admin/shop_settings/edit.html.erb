<h1 class="text-2xl font-bold mb-6">ตั้งค่าการชำระเงิน</h1>

<%= form_with model: [:admin, @shop_setting], html: { multipart: true }, class: "bg-white border rounded-lg p-6 space-y-4 max-w-xl" do |f| %>
  <div>
    <%= f.label :bank_name, "ธนาคาร", class: "block text-sm mb-1" %>
    <%= f.text_field :bank_name, class: "w-full rounded border px-3 py-2" %>
  </div>
  <div>
    <%= f.label :account_number, "เลขบัญชี", class: "block text-sm mb-1" %>
    <%= f.text_field :account_number, class: "w-full rounded border px-3 py-2" %>
  </div>
  <div>
    <%= f.label :account_name, "ชื่อบัญชี", class: "block text-sm mb-1" %>
    <%= f.text_field :account_name, class: "w-full rounded border px-3 py-2" %>
  </div>
  <div>
    <%= f.label :qr_code, "QR Code สำหรับชำระเงิน", class: "block text-sm mb-1" %>
    <%= f.file_field :qr_code, accept: "image/*", class: "block" %>
    <% if @shop_setting.qr_code.attached? %>
      <div class="mt-2"><%= image_tag @shop_setting.qr_code, class: "max-w-xs rounded border" %></div>
    <% end %>
  </div>
  <div>
    <%= f.label :payment_instructions, "คำแนะนำเพิ่มเติม", class: "block text-sm mb-1" %>
    <%= f.text_area :payment_instructions, rows: 4, class: "w-full rounded border px-3 py-2" %>
  </div>
  <%= f.submit "บันทึก", class: "rounded-lg bg-slate-900 text-white px-6 py-2 cursor-pointer" %>
<% end %>
