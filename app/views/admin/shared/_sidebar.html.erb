<aside class="admin-sidebar w-64 shrink-0 flex flex-col">
  <div class="p-5 border-b border-white/10">
    <%= link_to admin_root_path, class: "flex items-center gap-3 group" do %>
      <span class="w-10 h-10 rounded-xl bg-violet-600 flex items-center justify-center text-lg shadow-lg shadow-violet-900/50">🃏</span>
      <div>
        <p class="font-bold text-white leading-tight">Carshop</p>
        <p class="text-xs text-violet-400">Admin Panel</p>
      </div>
    <% end %>
  </div>

  <nav class="flex-1 p-4 space-y-6 overflow-y-auto">
    <div>
      <p class="text-[10px] font-bold uppercase tracking-widest text-slate-500 px-4 mb-2">ภาพรวม</p>
      <%= admin_nav_link "Dashboard", admin_root_path, icon: "📊" %>
      <%= admin_nav_link "ออเดอร์", admin_orders_path, icon: "🛒" %>
    </div>

    <div>
      <p class="text-[10px] font-bold uppercase tracking-widest text-slate-500 px-4 mb-2">สินค้า</p>
      <%= admin_nav_link "การ์ดทั้งหมด", admin_products_path, icon: "🎴" %>
      <%= admin_nav_link "เติมสต็อก", admin_stock_path, icon: "📦" %>
      <%= admin_nav_link "หมวดหมู่", admin_categories_path, icon: "🏷️" %>
    </div>

    <div>
      <p class="text-[10px] font-bold uppercase tracking-widest text-slate-500 px-4 mb-2">ลูกค้า</p>
      <%= admin_nav_link "คำร้อง / ฟีเจอร์", admin_feature_requests_path, icon: "💡" %>
    </div>

    <div>
      <p class="text-[10px] font-bold uppercase tracking-widest text-slate-500 px-4 mb-2">ตั้งค่า</p>
      <%= admin_nav_link "ชำระเงิน & QR", edit_admin_shop_setting_path, icon: "📱" %>
    </div>
  </nav>

  <div class="p-4 border-t border-white/10">
    <%= link_to root_path, class: "flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm text-slate-400 hover:bg-white/5 hover:text-white transition-all" do %>
      <span class="w-5 text-center">←</span>
      กลับหน้าร้าน
    <% end %>
    <% if user_signed_in? %>
      <p class="text-xs text-slate-600 px-4 mt-3 truncate"><%= current_user.email %></p>
    <% end %>
  </div>
</aside>
