<h1 class="text-2xl font-bold mb-6"><%= @product.new_record? ? "เพิ่มการ์ด" : "แก้ไขการ์ด" %></h1>

<%= form_with model: [:admin, @product], html: { multipart: true }, class: "bg-white border rounded-lg p-6 space-y-4 max-w-xl" do |f| %>
  <% if @product.errors.any? %>
    <div class="text-red-600 text-sm"><%= @product.errors.full_messages.to_sentence %></div>
  <% end %>
  <div>
    <%= f.label :name, "ชื่อการ์ด", class: "block text-sm mb-1" %>
    <%= f.text_field :name, class: "w-full rounded border px-3 py-2" %>
  </div>
  <div>
    <%= f.label :category_id, "หมวดหมู่", class: "block text-sm mb-1" %>
    <%= f.collection_select :category_id, @categories, :id, :name, {}, class: "w-full rounded border px-3 py-2" %>
  </div>
  <div>
    <%= f.label :description, "รายละเอียด", class: "block text-sm mb-1" %>
    <%= f.text_area :description, rows: 4, class: "w-full rounded border px-3 py-2" %>
  </div>
  <div>
    <%= f.label :image, "รูปการ์ด", class: "block text-sm mb-1" %>
    <%= f.file_field :image, accept: "image/*", class: "block" %>
    <% if @product.image.attached? %>
      <div class="mt-2"><%= image_tag @product.image, class: "max-w-xs rounded border" %></div>
    <% end %>
  </div>
  <%= f.submit "บันทึก", class: "rounded-lg bg-slate-900 text-white px-6 py-2 cursor-pointer" %>
<% end %>
