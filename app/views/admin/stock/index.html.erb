<h1 class="text-2xl font-bold mb-6">เติมสต็อก</h1>

<div class="flex flex-wrap gap-2 mb-6">
  <% @categories.each do |category| %>
    <%= link_to category.name,
        admin_stock_path(category_id: category.id),
        class: "rounded-full px-4 py-1.5 text-sm #{@selected_category&.id == category.id ? 'bg-slate-900 text-white' : 'bg-white border'}" %>
  <% end %>
</div>

<% if @selected_category %>
  <%= form_with url: admin_stock_path, method: :patch, class: "bg-white border rounded-lg overflow-hidden" do %>
    <%= hidden_field_tag :category_id, @selected_category.id %>

    <table class="w-full text-sm">
      <thead class="bg-slate-50 text-left">
        <tr>
          <th class="p-3">การ์ด</th>
          <th class="p-3">Variant</th>
          <th class="p-3">สต็อกปัจจุบัน</th>
          <th class="p-3">เติม (+N)</th>
        </tr>
      </thead>
      <tbody>
        <% @variants.each do |variant| %>
          <tr class="border-t">
            <td class="p-3 font-medium"><%= variant.product.name %></td>
            <td class="p-3"><%= variant.display_label %></td>
            <td class="p-3">
              <span class="<%= variant.stock_quantity <= 3 ? 'text-red-600 font-medium' : '' %>">
                <%= variant.stock_quantity %>
              </span>
            </td>
            <td class="p-3">
              <%= number_field_tag "replenishments[#{variant.id}]", nil, min: 0, placeholder: "0", class: "w-24 rounded border px-2 py-1" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <div class="p-4 border-t bg-slate-50 text-right">
      <%= submit_tag "บันทึกทั้งหมด", class: "rounded-lg bg-slate-900 text-white px-6 py-2 cursor-pointer" %>
    </div>
  <% end %>
<% else %>
  <p class="text-slate-500">ยังไม่มีหมวดหมู่ — สร้างหมวดหมู่ก่อน</p>
<% end %>
