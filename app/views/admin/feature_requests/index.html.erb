<h1 class="text-2xl font-bold text-slate-800 mb-2">💡 คำร้อง / แนะนำฟีเจอร์</h1>
<p class="text-slate-500 mb-6">ไอเดียจากลูกค้า — อัปเดตสถานะได้</p>

<div class="flex flex-wrap gap-2 mb-6">
  <%= link_to "ทั้งหมด", admin_feature_requests_path, class: "rounded-full px-4 py-1.5 text-sm #{params[:status].blank? ? 'bg-violet-600 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'}" %>
  <% FeatureRequest.statuses.each_key do |status| %>
    <%= link_to FeatureRequest.new(status: status).status_label,
        admin_feature_requests_path(status: status),
        class: "rounded-full px-4 py-1.5 text-sm #{params[:status] == status ? 'bg-violet-600 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'}" %>
  <% end %>
</div>

<div class="space-y-4">
  <% @feature_requests.each do |req| %>
    <div class="admin-card p-6">
      <div class="flex flex-wrap justify-between gap-4 mb-3">
        <div>
          <h2 class="font-semibold text-slate-800"><%= req.title %></h2>
          <p class="text-sm text-slate-500"><%= req.name %> · <%= req.email %> · <%= l(req.created_at, format: :long) %></p>
        </div>
        <span class="rounded-full px-3 py-1 text-sm h-fit bg-slate-100 text-slate-600"><%= req.status_label %></span>
      </div>
      <p class="text-slate-600 text-sm whitespace-pre-line mb-4"><%= req.description %></p>

      <div class="flex flex-wrap gap-2">
        <% FeatureRequest.statuses.each_key do |status| %>
          <%= button_to FeatureRequest.new(status: status).status_label,
              admin_feature_request_path(req, status: status),
              method: :patch,
              class: "rounded-lg px-3 py-1.5 text-xs border border-slate-200 text-slate-600 hover:bg-violet-50 hover:border-violet-200 hover:text-violet-700 transition-colors" %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<% if @feature_requests.empty? %>
  <div class="admin-card p-12 text-center text-slate-500">ยังไม่มีคำร้อง</div>
<% end %>
