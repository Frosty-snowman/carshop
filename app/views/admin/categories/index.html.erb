<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold">หมวดหมู่</h1>
  <%= link_to "เพิ่มหมวดหมู่", new_admin_category_path, class: "rounded-lg bg-slate-900 text-white px-4 py-2" %>
</div>

<div class="bg-white border rounded-lg overflow-hidden">
  <table class="w-full text-sm">
    <thead class="bg-slate-50 text-left">
      <tr>
        <th class="p-3">ชื่อ</th>
        <th class="p-3">ลำดับ</th>
        <th class="p-3">จำนวนการ์ด</th>
        <th class="p-3"></th>
      </tr>
    </thead>
    <tbody>
      <% @categories.each do |category| %>
        <tr class="border-t">
          <td class="p-3 font-medium"><%= category.name %></td>
          <td class="p-3"><%= category.position %></td>
          <td class="p-3"><%= category.products.count %></td>
          <td class="p-3 text-right space-x-2">
            <%= link_to "แก้ไข", edit_admin_category_path(category), class: "text-indigo-600" %>
            <%= button_to "ลบ", admin_category_path(category), method: :delete, form: { data: { turbo_confirm: "ลบหมวดหมู่นี้?" } }, class: "text-red-600 inline" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
