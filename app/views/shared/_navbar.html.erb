<header class="bg-white border-b border-slate-200 sticky top-0 z-10">
  <div class="max-w-6xl mx-auto px-4 py-4 flex flex-wrap items-center justify-between gap-4">
    <%= link_to root_path, class: "text-xl font-bold text-slate-900" do %>
      Carshop
    <% end %>

    <nav class="flex flex-wrap items-center gap-4 text-sm">
      <%= link_to "การ์ดทั้งหมด", products_path, class: "text-slate-700 hover:text-slate-900" %>

      <% if user_signed_in? %>
        <% if current_user.admin? %>
          <%= link_to "Admin", admin_root_path, class: "text-indigo-600 font-medium" %>
        <% end %>
        <%= link_to "คำสั่งซื้อ", orders_path, class: "text-slate-700 hover:text-slate-900" %>
        <%= link_to cart_items_path, class: "text-slate-700 hover:text-slate-900" do %>
          ตะกร้า (<%= cart_count %>)
        <% end %>
        <span class="text-slate-500">สวัสดี, <%= current_user.name %></span>
        <%= button_to "ออกจากระบบ", destroy_user_session_path, method: :delete, class: "text-red-600" %>
      <% else %>
        <%= link_to "เข้าสู่ระบบ", new_user_session_path, class: "text-slate-700 hover:text-slate-900" %>
        <%= link_to "สมัครสมาชิก", new_user_registration_path, class: "rounded-lg bg-slate-900 text-white px-4 py-2" %>
      <% end %>
    </nav>
  </div>
</header>
