<header class="sticky top-0 z-50 glass border-b border-white/5">
  <div class="max-w-6xl mx-auto px-4 py-3 flex flex-wrap items-center justify-between gap-4">
    <%= link_to root_path, class: "flex items-center gap-2 group" do %>
      <span class="text-2xl animate-float inline-block">🃏</span>
      <span class="text-xl font-bold bg-gradient-to-r from-violet-400 to-indigo-400 bg-clip-text text-transparent group-hover:from-violet-300 group-hover:to-indigo-300 transition-all duration-300">
        Carshop
      </span>
    <% end %>

    <nav class="flex flex-wrap items-center gap-5">
      <%= link_to "การ์ดทั้งหมด", products_path, class: "nav-link" %>

      <% if user_signed_in? %>
        <% if current_user.admin? %>
          <%= link_to admin_root_path, class: "nav-link font-medium text-violet-400 hover:text-violet-300" do %>
            ⚙ Admin
          <% end %>
        <% end %>
        <%= link_to "คำสั่งซื้อ", orders_path, class: "nav-link" %>
        <%= link_to cart_items_path, class: "nav-link relative" do %>
          ตะกร้า
          <% if cart_count > 0 %>
            <span class="absolute -top-2 -right-4 min-w-[18px] h-[18px] flex items-center justify-center rounded-full bg-violet-500 text-[10px] font-bold text-white px-1 animate-pulse-glow">
              <%= cart_count %>
            </span>
          <% end %>
        <% end %>
        <span class="text-white/40 text-sm hidden sm:inline">|</span>
        <span class="text-sm text-white/60">สวัสดี, <%= current_user.name %></span>
        <%= button_to "ออก", destroy_user_session_path, method: :delete, class: "btn-ghost text-red-400/70 hover:text-red-400" %>
      <% else %>
        <%= link_to "เข้าสู่ระบบ", new_user_session_path, class: "nav-link" %>
        <%= link_to "สมัครสมาชิก", new_user_registration_path, class: "btn-primary !px-5 !py-2 text-sm" %>
      <% end %>
    </nav>
  </div>
</header>
