<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Carshop - ร้านการ์ด" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-slate-50 min-h-screen">
    <%= render "shared/navbar" %>

    <% if notice.present? %>
      <div class="max-w-6xl mx-auto px-4 mt-4">
        <p class="rounded-lg bg-green-50 text-green-800 px-4 py-3 border border-green-200"><%= notice %></p>
      </div>
    <% end %>
    <% if alert.present? %>
      <div class="max-w-6xl mx-auto px-4 mt-4">
        <p class="rounded-lg bg-red-50 text-red-800 px-4 py-3 border border-red-200"><%= alert %></p>
      </div>
    <% end %>

    <main class="max-w-6xl mx-auto px-4 py-8">
      <%= yield %>
    </main>
  </body>
</html>
