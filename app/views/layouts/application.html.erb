<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Carshop - ร้านการ์ด" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="page-bg text-white antialiased">
    <%= render "shared/navbar" %>
    <%= render "shared/flash" %>

    <main class="max-w-6xl mx-auto px-4 py-8">
      <%= yield %>
    </main>

    <footer class="border-t border-white/5 mt-16">
      <div class="max-w-6xl mx-auto px-4 py-8 flex flex-wrap items-center justify-between gap-4 text-sm text-white/40">
        <span class="font-medium text-white/60">Carshop</span>
        <span>ร้านการ์ด Pokemon · Yu-Gi-Oh! · One Piece</span>
      </div>
    </footer>
  </body>
</html>
