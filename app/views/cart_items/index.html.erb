<h1 class="text-2xl font-bold mb-6">ตะกร้าสินค้า</h1>

<% if @cart_items.any? %>
  <div class="space-y-4">
    <% @cart_items.each do |item| %>
      <div class="bg-white border rounded-lg p-4 flex flex-wrap justify-between gap-4">
        <div>
          <p class="font-semibold"><%= item.product_variant.product.name %></p>
          <p class="text-sm text-slate-600"><%= item.product_variant.display_label %></p>
          <p class="text-indigo-600 mt-1"><%= format_baht(item.product_variant.price) %> × <%= item.quantity %></p>
        </div>
        <div class="flex items-center gap-3">
          <%= form_with model: item, url: cart_item_path(item), method: :patch, class: "flex items-center gap-2" do |f| %>
            <%= f.number_field :quantity, min: 1, max: item.product_variant.stock_quantity, class: "w-16 rounded border px-2 py-1" %>
            <%= f.submit "อัปเดต", class: "text-sm rounded border px-3 py-1 cursor-pointer" %>
          <% end %>
          <%= button_to "ลบ", cart_item_path(item), method: :delete, class: "text-sm text-red-600" %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="mt-8 bg-white border rounded-lg p-6 flex flex-wrap items-center justify-between gap-4">
    <p class="text-xl font-bold">รวม <%= format_baht(cart_total) %></p>
    <%= link_to "ไปชำระเงิน", new_checkout_path, class: "rounded-lg bg-slate-900 text-white px-6 py-3" %>
  </div>
<% else %>
  <p class="text-slate-500">ตะกร้าว่าง</p>
  <%= link_to "เลือกการ์ด", products_path, class: "inline-block mt-4 text-indigo-600" %>
<% end %>
