<div class="animate-fade-in-up">
  <h1 class="text-3xl font-bold mb-2">ตะกร้าสินค้า</h1>
  <p class="text-white/40 mb-8">ตรวจสอบรายการก่อนชำระเงิน</p>

  <% if @cart_items.any? %>
    <div class="space-y-4">
      <% @cart_items.each_with_index do |item, i| %>
        <div class="glass rounded-xl p-5 flex flex-wrap justify-between gap-4 transition-all duration-300 hover:border-white/15 animate-fade-in-up"
             style="animation-delay: <%= 0.05 * i %>s">
          <div>
            <p class="font-semibold text-white"><%= item.product_variant.product.name %></p>
            <p class="text-sm text-white/40 mt-1"><%= item.product_variant.display_label %></p>
            <p class="text-lg font-bold bg-gradient-to-r from-violet-400 to-indigo-400 bg-clip-text text-transparent mt-2">
              <%= format_baht(item.product_variant.price) %> × <%= item.quantity %>
            </p>
          </div>
          <div class="flex items-center gap-3">
            <%= form_with model: item, url: cart_item_path(item), method: :patch, class: "flex items-center gap-2" do |f| %>
              <%= f.number_field :quantity, min: 1, max: item.product_variant.available_quantity, class: "input-field !w-20 !py-2 text-center" %>
              <%= f.submit "อัปเดต", class: "btn-secondary !py-2 !px-4 text-sm" %>
            <% end %>
            <%= button_to "ลบ", cart_item_path(item), method: :delete, class: "text-sm text-red-400/70 hover:text-red-400 transition-colors px-2" %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="glass-strong rounded-2xl p-6 mt-8 flex flex-wrap items-center justify-between gap-4 animate-fade-in-up" style="animation-delay: 0.2s">
      <div>
        <p class="text-sm text-white/40">ยอดรวมทั้งหมด</p>
        <p class="text-2xl font-bold bg-gradient-to-r from-violet-400 to-amber-400 bg-clip-text text-transparent">
          <%= format_baht(cart_total) %>
        </p>
      </div>
      <%= link_to "ไปชำระเงิน →", new_checkout_path, class: "btn-primary" %>
    </div>
  <% else %>
    <div class="glass rounded-2xl p-16 text-center animate-fade-in">
      <span class="text-5xl mb-4 block opacity-20">🛒</span>
      <p class="text-white/40 mb-6">ตะกร้าว่าง — ยังไม่มีการ์ด</p>
      <%= link_to "เลือกการ์ด", products_path, class: "btn-primary" %>
    </div>
  <% end %>
</div>
